{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/heddlehq/Bobbin/main/priv/integration.schema.json",
  "title": "Heddle integration manifest",
  "type": "object",
  "required": ["id", "name", "version", "base_url", "actions"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"},
    "description": {"type": "string"},
    "icon": {"type": "string"},
    "category": {"type": "string"},
    "author": {"type": "string"},
    "homepage": {"type": "string"},
    "base_url": {"type": "string", "pattern": "^(https?://|\\{\\{\\s*credential\\.)", "description": "May take values of the credential: https://{{credential.subdomain}}.example.com/ or {{credential.url}}/api/."},
    "i18n": {
      "type": "object",
      "description": "Texts in other languages, by locale (pt-BR): description, and under actions.<name> and triggers.<name> a name, a description and fields.<field name> labels.",
      "additionalProperties": {"type": "object"}
    },
    "credential": {
      "type": "object",
      "required": ["auth"],
      "properties": {
        "kind": {"type": "string"},
        "label": {"type": "string"},
        "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
        "auth": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {"enum": ["bearer", "header", "query", "basic", "oauth2", "none"]},
            "token": {"type": "string"},
            "name": {"type": "string"},
            "value": {"type": "string"},
            "username": {"type": "string"},
            "password": {"type": "string"},
            "authorize_url": {"type": "string"},
            "token_url": {"type": "string"},
            "scopes": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "errors": {
      "type": "object",
      "properties": {
        "ok_path": {"type": "string"},
        "message_path": {"type": "string"}
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/action"}
    },
    "triggers": {
      "type": "array",
      "description": "Start a flow when something new shows up: the request is called every poll.every minutes, and the flow starts once for each item whose poll.id it hadn't seen.",
      "items": {
        "allOf": [
          {"$ref": "#/$defs/action"},
          {
            "type": "object",
            "properties": {
              "poll": {
                "type": "object",
                "properties": {
                  "every": {"type": "integer", "minimum": 1, "default": 5},
                  "id": {"type": "string", "minLength": 1, "default": "id"}
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "action": {
    "type": "object",
    "required": ["name", "request"],
    "properties": {
      "name": {"type": "string", "minLength": 1},
      "description": {"type": "string"},
      "resource": {"type": "string", "description": "What the action works on, like Contact or Deal. Heddle groups actions by it."},
      "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
      "request": {
        "type": "object",
        "required": ["method", "path"],
        "properties": {
          "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]},
          "path": {"type": "string"},
          "headers": {"type": "object"},
          "query": {"type": "object"},
          "body": {},
          "body_type": {"enum": ["json", "form"]}
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "path": {"type": "string"},
          "pick": {"type": "array", "items": {"type": "string"}},
          "value": {}
        }
      },
      "pagination": {
        "type": "object",
        "required": ["type", "items_path"],
        "properties": {
          "type": {"enum": ["cursor", "offset", "link"]},
          "items_path": {"type": "string"},
          "page_size": {"type": "integer", "minimum": 1},
          "limit_param": {"type": "string"},
          "cursor_param": {"type": "string"},
          "next_path": {"type": "string"},
          "offset_param": {"type": "string"}
        }
      }
    }
  },
    "field": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "label": {"type": "string"},
        "type": {"enum": ["text", "textarea", "number", "select", "boolean", "json", "multiselect", "datetime"]},
        "default": {},
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "properties": {"label": {"type": "string"}, "value": {"type": "string"}}
          }
        },
        "secret": {"type": "boolean"},
        "required": {"type": "boolean"},
        "strip": {"type": "string"}
      }
    }
  }
}
